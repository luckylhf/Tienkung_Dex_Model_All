      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Tree:
        right_hand_base:
          right_hand_palm:
            right_thumb_yaw:
              right_thumb_mcp:
                right_thumb_pip:
                  right_thumb_dip:
                    right_thumb_force_sensor:
                      right_thumb_tip: {}
            right_index_yaw:
              right_index_mcp:
                right_index_pip:
