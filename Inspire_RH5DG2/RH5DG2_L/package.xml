<?xml version="1.0"?>
<package format="3">
  <name>RH5DG2_L</name>
  <version>1.0.0</version>
  <description>
    <p>URDF Description package for RH5DG2_L</p>
    <p>This package contains configuration data, 3D models and launch files for RH5DG2_L urdf</p>
  </description>
  <author>none</author>
  <maintainer email="anonymous@anonymous.com">anonymous</maintainer>
  <license>BSD</license>

  <!-- Build tool dependency for ROS 2 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime dependencies -->
  <depend>robot_state_publisher</depend>
  <depend>rviz2</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>gazebo_ros</depend>
  <exec_depend>xacro</exec_depend> 

  <!-- Export section -->
  <export>
    <architecture_independent />
    <build_type>ament_cmake</build_type>
  </export>
</package>

